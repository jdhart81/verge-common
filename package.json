{
  "name": "verge-common",
  "version": "0.10.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --test tests/*.test.mjs",
    "simulate:coop": "node scripts/simulate-coop-journey.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.json",
    "launch": "node scripts/launch.mjs",
    "mcp": "node mcp/stdio.mjs",
    "build:public": "node public-site/build.mjs",
    "build:selfhost": "VERGE_SELF_HOSTED=1 vinext build",
    "start:selfhost": "node self-hosted/server.mjs",
    "backup:selfhost": "node self-hosted/backup.mjs",
    "launch-gate": "node scripts/launch-gate.mjs",
    "pilot:readiness": "node scripts/pilot-readiness.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@shadcn/react": "0.3.1",
    "@turf/area": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@viridis/dfm-core": "file:vendor/viridis-dfm-core-0.2.0.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.11.2",
    "openid-client": "6.8.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.13.3",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.12",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/workers-types": "5.20260929.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "wrangler": "4.144.0"
  },
  "type": "module",
