{
    admin off
}
www.vergecommon.com {
    redir https://vergecommon.com{uri} permanent
}
vergecommon.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy vergecommon-app:3000 {
        header_up X-Real-IP {remote_host}
    }
}

# Dendritic Forest Management site (static container from jdhart81/hdfm-framework
# apps/site) on the private vergecommon network. Add only after DNS for these
# names points at this server; see docs/DFM_SITE.md.
www.dendriticforest.org {
    redir https://dendriticforest.org{uri} permanent
}
dendriticforest.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options DENY
        -Server
    }
    reverse_proxy dendriticforest-site:8080
}
unbrokenwoods.org, www.unbrokenwoods.org {
    redir https://dendriticforest.org/unbroken/ permanent
}
