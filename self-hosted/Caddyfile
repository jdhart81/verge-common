{
    admin off
}
www.vergecommon.com {
    redir https://vergecommon.com{uri} permanent
}
vergecommon.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    reverse_proxy vergecommon-app:3000 {
        header_up X-Real-IP {remote_host}
    }
}
